{
  "name": "codex-chatgpt-web",
  "version": "6.0.0",
  "private": true,
  "description": "A checked Bend application for retained ChatGPT webpages and native Codex tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miuuyy/codex-chatgpt-web.git"
  },
  "homepage": "https://github.com/miuuyy/codex-chatgpt-web#readme",
  "bugs": {
    "url": "https://github.com/miuuyy/codex-chatgpt-web/issues"
  },
  "packageManager": "bun@1.4.0",
  "type": "module",
  "bin": {
    "codex-chatgpt-web": "./runtime/cli.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSES"
  ],
  "scripts": {
    "start": "bun runtime/cli.ts serve",
    "setup": "bun runtime/cli.ts setup",
    "doctor": "bun runtime/cli.ts doctor",
    "migrate": "bun runtime/cli.ts migrate",
    "install-models": "bun runtime/cli.ts install-models",
    "app": "bun runtime/cli.ts desktop",
    "dev:app": "bun runtime/cli.ts dev desktop",
    "dev:chat": "bun runtime/cli.ts dev chat",
    "dev:serve": "bun runtime/cli.ts dev serve",
    "test": "bun test ./test",
    "typecheck": "tsc --noEmit",
    "bend:setup": "python3 tools/bootstrap.py",
    "bend:build": "python3 tools/build.py --native",
    "bend:check": "python3 tools/build.py --check",
    "bend:verify": "python3 tools/proof_tests.py",
    "build": "bun tools/package.ts",
    "smoke": "bun tools/smoke.ts dist/runtime",
    "app:package": "bun run build && bun run --cwd desktop package",
    "app:package:dir": "bun run build && bun run --cwd desktop package:dir",
    "app:smoke": "bun tools/desktop-smoke.ts",
    "verify": "bun tools/verify.ts",
    "audit": "bun audit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "playwright-core": "1.62.0",
    "tiktoken": "1.0.22",
    "turndown": "7.2.0",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/turndown": "5.0.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": "1.4.0"
  },
  "overrides": {
    "fast-uri": "3.1.6"
  },
  "keywords": [
    "codex",
    "chatgpt",
    "responses-api",
    "mcp",
    "playwright"
  ],
  "license": "MIT"
}
