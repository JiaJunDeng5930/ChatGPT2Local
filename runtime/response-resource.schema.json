{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:chatgpt-web:response:v1",
  "title": "ChatGPT Web API v1 response resource",
  "type": "object",
  "required": ["id", "object", "protocol", "created_at", "previous_response_id", "status", "model", "output", "usage"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^resp_[a-f0-9]{64}$" },
    "object": { "const": "web.response" },
    "protocol": { "const": "chatgpt-web.v1" },
    "created_at": { "type": "integer", "minimum": 0 },
    "previous_response_id": { "type": ["string", "null"], "pattern": "^resp_[a-f0-9]{64}$" },
    "status": { "enum": ["in_progress", "requires_action", "completed", "interrupted", "cancelled"] },
    "model": { "type": "string", "pattern": "^chatgpt-web/(light|medium|high|xhigh|pro)$" },
    "output": { "type": "array", "items": { "oneOf": [{ "$ref": "#/definitions/message" }, { "$ref": "#/definitions/call" }] } },
    "usage": { "oneOf": [
      { "type": "null" },
      { "type": "object", "required": ["input_tokens", "output_tokens", "total_tokens", "estimated"], "additionalProperties": false,
        "properties": { "input_tokens": { "type": "integer", "minimum": 0 }, "output_tokens": { "type": "integer", "minimum": 0 },
          "total_tokens": { "type": "integer", "minimum": 0 }, "estimated": { "const": true } } }
    ] },
    "error": { "type": "object", "required": ["code", "message"], "additionalProperties": false,
      "properties": { "code": { "type": "string" }, "message": { "type": "string" } } }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "completed" } } },
      "then": { "properties": { "output": { "minItems": 1, "maxItems": 1, "items": { "$ref": "#/definitions/message" } } } } },
    { "if": { "properties": { "status": { "const": "requires_action" } } },
      "then": { "properties": { "output": { "minItems": 1, "items": { "$ref": "#/definitions/call" } }, "usage": { "type": "null" } } } },
    { "if": { "properties": { "status": { "enum": ["in_progress", "interrupted", "cancelled"] } } },
      "then": { "properties": { "output": { "maxItems": 0 }, "usage": { "type": "null" } } } },
    { "if": { "properties": { "status": { "const": "interrupted" } } }, "then": { "required": ["error"] } }
  ],
  "definitions": {
    "message": {
      "type": "object", "required": ["type", "role", "content"], "additionalProperties": false,
      "properties": { "type": { "const": "message" }, "role": { "const": "assistant" },
        "content": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["type", "text"],
          "additionalProperties": false, "properties": { "type": { "const": "output_text" }, "text": { "type": "string" } } } } }
    },
    "call": {
      "oneOf": [
        { "type": "object", "required": ["id", "call_id", "type", "name", "arguments"], "additionalProperties": false,
          "properties": { "id": { "type": "string" }, "call_id": { "type": "string", "minLength": 1 }, "type": { "const": "function_call" },
            "name": { "type": "string" }, "arguments": { "type": "object" } } },
        { "type": "object", "required": ["id", "call_id", "type", "name", "input"], "additionalProperties": false,
          "properties": { "id": { "type": "string" }, "call_id": { "type": "string", "minLength": 1 }, "type": { "const": "custom_tool_call" },
            "name": { "type": "string" }, "input": { "type": "string" } } }
      ]
    }
  }
}
